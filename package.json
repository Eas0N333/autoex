{
  "name": "ai-quiz-solver",
  "version": "1.0.0",
  "private": true,
  "description": "Online question recognition + AI answering system (zero-dependency Node server, zero-build web UI)",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "desktop": "electron .",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "pack:win": "electron-builder --win nsis portable --publish never",
    "pack:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "demo:page": "node scripts/demo-page.mjs",
    "pack:mac:universal": "electron-builder --mac dmg zip --universal --publish never"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.aiquiz.overlay",
    "productName": "AI 答题助手",
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/render.js",
      "package.json",
      "build/icon.png",
      "build/icon.icns",
      "build/tray.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "需要屏幕录制权限以识别浏览器中的题目",
        "LSUIElement": true,
        "NSHighResolutionCapable": true,
        "NSAppleEventsUsageDescription": "需要访问系统设置以打开屏幕录制权限面板",
        "LSApplicationCategoryType": "public.app-category.education",
        "CFBundleDisplayName": "AI 答题助手",
        "NSHumanReadableCopyright": "Copyright © 2026 AI 答题助手"
      },
      "artifactName": "ai-quiz-solver-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
